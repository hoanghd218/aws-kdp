# =================================================================
# AWS KDP Coloring Book Generator - Environment Configuration Sample
# =================================================================
# Copy this file to .env or .env.local and fill in your own values.
# 
# WARNING: NEVER commit .env or files with real credentials to git!
# =================================================================

# ---- Image Renderer Selection ----
# Options: ai33 | bimai | kie | nanopic | chatgpt
IMAGE_RENDERER=ai33

# ---- Renderer API Keys (Fill in the ones you use) ----
AI33_KEY=your_ai33_key_here
BIMAI_API_KEY=your_bimai_key_here
KIE_API_KEY=your_kie_key_here

# NanoPic - supports multiple tokens separated by commas for round-robin
NANOPIC_ACCESS_TOKEN=your_nanopic_access_token_here
NANOPIC_API_KEY=your_nanopic_api_key_here

# ChatGPT / OpenAI API settings
CHATGPT_API_KEY=your_chatgpt_api_key_here
CHATGPT_API_URL=https://api.openai.com/v1/images/generations
CHATGPT_MODEL=dall-e-3

# ---- Third-Party Services ----
# Apify token for KDP niche finder / research (supports multiple tokens separated by commas)
APIFY_API_TOKEN=your_apify_api_token_here

# ---- Author Info (Default values shown on cover + title page + copyright) ----
AUTHOR_FIRST_NAME=BoBo
AUTHOR_LAST_NAME=Art
